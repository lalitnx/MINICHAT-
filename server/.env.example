# ──────────────────────────────────────────────
# MiniChat Server — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# MongoDB connection string (local dev or Atlas)
MONGODB_URI=mongodb://localhost:27017/minichat

# Secret key for signing JWTs — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-string

# Google Gemini API key for content moderation
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Frontend URL — used for CORS whitelist
CLIENT_URL=http://localhost:5173

# Port the server listens on
PORT=5000
